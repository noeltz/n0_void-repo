# Template file for 'dgop'
pkgname=dgop
version=1.6.0
revision=1
build_style=go
go_import_path="github.com/AvengeMedia/dgop"
go_package="${go_import_path}/cmd/dgop"
short_desc="Stateless, cursor-based system and process monitoring tool"
maintainer="noeltz <https://github.com/noeltz>"
license="MIT"
homepage="https://github.com/AvengeMedia/dgop"

_n0_source=github-release
_n0_repo=AvengeMedia/dgop
_n0_strip=v

distfiles="https://github.com/AvengeMedia/dgop/archive/refs/tags/v${version}.tar.gz"
checksum=ab97d4bd9483de47051f984ecf3f877d289c316f8a35a9c3d9e5cfaa73b7f2b9

post_install() {
    # Install the sample config if it exists in the root of the source
    if [ -f "config.sample.toml" ]; then
        vmkdir etc/dgop
        vinstall config.sample.toml 0644 etc/dgop config.toml
    fi
    
    # Optional: Install a license file if present
    if [ -f "LICENSE" ]; then
        vlicense LICENSE
    fi
}
