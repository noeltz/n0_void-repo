# Template file for 'nlohmann_json'
# Not in upstream void-packages yet. Needed as a makedepend for umbriel,
# which resolves it via meson's dependency('nlohmann_json') -> pkg-config
# nlohmann_json.pc (generated by CMake on install). Header-only, so this
# follows the same no-devel-split convention as valijson/rapidjson: there
# is no .so to separate a runtime package from.
pkgname=nlohmann_json
version=3.12.0
revision=1
build_style=cmake
configure_args="-DJSON_BuildTests=OFF -DJSON_MultipleHeaders=ON"
short_desc="JSON for Modern C++ (header-only library)"
maintainer="noeltz <https://github.com/noeltz>"
_n0_source=github-release
_n0_repo=noctalia-dev/noctalia
_n0_strip=v
license="MIT"
homepage="https://github.com/nlohmann/json"
changelog="https://github.com/nlohmann/json/releases"
distfiles="https://codeload.github.com/nlohmann/json/tar.gz/refs/tags/v${version}>nlohmann_json-${version}.tar.gz"
checksum=4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187

post_install() {
	vlicense LICENSE.MIT
}
